{
  "info": {
    "name": "Restful Booker - Tests API",
    "description": "Tests automatisés de l'API Restful Booker : authentification, parcours CRUD de réservation, cas d'erreur et contrôles d'accès. Auteur : Soumia Sadki.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Disponibilité",
      "item": [
        {
          "name": "Healthcheck - l'API répond",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ping"
              ]
            },
            "description": "Vérifie que l'API est disponible avant de lancer les autres tests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Le statut est 201 (comportement documenté de l'API)\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Temps de réponse < 5 s\", () => pm.expect(pm.response.responseTime).to.be.below(5000));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Authentification",
      "item": [
        {
          "name": "Connexion avec identifiants valides",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Le statut est 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Un token est renvoyé\", () => {",
                  "    pm.expect(json).to.have.property(\"token\");",
                  "    pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.collectionVariables.set(\"token\", json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Connexion avec mot de passe invalide",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"mauvais-mot-de-passe\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"Aucun token n'est renvoyé\", () => pm.expect(json).to.not.have.property(\"token\"));",
                  "pm.test(\"Le message 'Bad credentials' est affiché\", () => pm.expect(json.reason).to.eql(\"Bad credentials\"));",
                  "// Anomalie AN-01 : l'API renvoie 200 au lieu de 401 (voir README)",
                  "pm.test(\"[AN-01] Statut renvoyé : 200 (401 attendu)\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Parcours réservation (CRUD)",
      "item": [
        {
          "name": "Créer une réservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Soumia\",\n  \"lastname\": \"Testeuse\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-12-01\",\n    \"checkout\": \"2026-12-05\"\n  },\n  \"additionalneeds\": \"Petit-déjeuner\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Le statut est 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const envoye = JSON.parse(pm.request.body.raw);",
                  "pm.test(\"Un identifiant de réservation est renvoyé\", () => pm.expect(json.bookingid).to.be.a(\"number\"));",
                  "pm.test(\"Les données enregistrées correspondent aux données envoyées\", () => {",
                  "    pm.expect(json.booking.firstname).to.eql(envoye.firstname);",
                  "    pm.expect(json.booking.lastname).to.eql(envoye.lastname);",
                  "    pm.expect(json.booking.totalprice).to.eql(envoye.totalprice);",
                  "    pm.expect(json.booking.bookingdates).to.eql(envoye.bookingdates);",
                  "});",
                  "pm.test(\"Le schéma de la réponse est conforme\", () => {",
                  "    const schema = {",
                  "        type: \"object\",",
                  "        required: [\"bookingid\", \"booking\"],",
                  "        properties: {",
                  "            bookingid: { type: \"number\" },",
                  "            booking: {",
                  "                type: \"object\",",
                  "                required: [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\"],",
                  "                properties: {",
                  "                    firstname: { type: \"string\" },",
                  "                    lastname: { type: \"string\" },",
                  "                    totalprice: { type: \"number\" },",
                  "                    depositpaid: { type: \"boolean\" },",
                  "                    bookingdates: { type: \"object\", required: [\"checkin\", \"checkout\"] }",
                  "                }",
                  "            }",
                  "        }",
                  "    };",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "pm.collectionVariables.set(\"bookingId\", json.bookingid);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consulter la réservation créée",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Le statut est 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"La réservation contient les bonnes informations\", () => {",
                  "    pm.expect(json.firstname).to.eql(\"Soumia\");",
                  "    pm.expect(json.lastname).to.eql(\"Testeuse\");",
                  "    pm.expect(json.depositpaid).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Rechercher la réservation par nom",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking?firstname=Soumia&lastname=Testeuse",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ],
              "query": [
                {
                  "key": "firstname",
                  "value": "Soumia"
                },
                {
                  "key": "lastname",
                  "value": "Testeuse"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Le statut est 200\", () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().map(b => b.bookingid);",
                  "pm.test(\"La réservation créée apparaît dans les résultats\", () => {",
                  "    pm.expect(ids).to.include(Number(pm.collectionVariables.get(\"bookingId\")));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Modifier la réservation (avec token)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Soumia\",\n  \"lastname\": \"Testeuse\",\n  \"totalprice\": 200,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-12-01\",\n    \"checkout\": \"2026-12-05\"\n  },\n  \"additionalneeds\": \"Petit-déjeuner\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Le statut est 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Le prix total est mis à jour\", () => pm.expect(pm.response.json().totalprice).to.eql(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Modifier partiellement la réservation (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"additionalneeds\": \"Dîner\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Le statut est 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Seul le champ envoyé est modifié\", () => {",
                  "    pm.expect(json.additionalneeds).to.eql(\"Dîner\");",
                  "    pm.expect(json.totalprice).to.eql(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Supprimer la réservation",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Anomalie AN-03 : l'API renvoie 201 Created pour une suppression (200 ou 204 attendu)",
                  "pm.test(\"La suppression est acceptée (2xx)\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Vérifier que la réservation supprimée n'existe plus",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Le statut est 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Cas d'erreur et sécurité",
      "item": [
        {
          "name": "Modifier une réservation sans token",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "1"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Soumia\",\n  \"lastname\": \"Testeuse\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-12-01\",\n    \"checkout\": \"2026-12-05\"\n  },\n  \"additionalneeds\": \"Petit-déjeuner\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"L'accès est refusé (403)\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Supprimer une réservation avec un token invalide",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token=token-invalide"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "1"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"L'accès est refusé (403)\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Créer une réservation incomplète (champs obligatoires manquants)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Soumia\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La réservation est refusée (pas de 2xx)\", () => pm.expect(pm.response.code).to.not.be.within(200, 299));",
                  "// Anomalie AN-02 : l'API renvoie 500 au lieu de 400 (voir README)",
                  "pm.test(\"[AN-02] Statut renvoyé : 500 (400 attendu)\", () => pm.response.to.have.status(500));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consulter une réservation inexistante",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/999999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "999999999"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Le statut est 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://restful-booker.herokuapp.com"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "password123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    }
  ]
}
